{
  "name": "gouda-matrix",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "dev",
	"containerUser": "dev",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "username": "dev",
      "userUid": "1000",
      "userGid": "1000",
      "installZsh": false,
      "installOhMyZsh": false
    }
  },
  "customizations": {
    "zed": {
      "extensions": [
        "typos"
      ]
    },
    "vscode": {
      "extensions": [
        "rust.rust-analyzer"
      ]
    }
  }
}
